{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customsignforge",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customsignforge-development",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "customsignforge-development-media"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "SITE_URL": "https://customsignforge.com",
    "LOCAL_ADMIN_ENABLED": "true"
  }
}
