{
  "name": "custom-sign-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs astro dev --host 127.0.0.1 --port 4321",
    "build": "node scripts/run.mjs astro build",
    "preview": "node scripts/run.mjs wrangler dev --config dist/server/wrangler.json --port 4321 --persist-to .wrangler/state",
    "db:migrate": "node scripts/run.mjs wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/run.mjs wrangler d1 execute DB --local --file=./scripts/seed.sql",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/run.mjs astro check",
    "types": "node scripts/run.mjs wrangler types src/env.d.ts --strict-vars=false",
    "test:live": "node scripts/live-smoke.mjs",
    "preview:astro": "node scripts/run.mjs astro preview --host 127.0.0.1 --port 4321",
    "init:local": "node scripts/init-local.mjs"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "@astrojs/cloudflare": "latest",
    "@astrojs/react": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "marked": "^18.1.1",
    "jose": "^6.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "wrangler": "latest",
    "typescript": "^5.9.0",
    "@astrojs/check": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@cloudflare/workers-types": "latest"
  }
}
