---
import { env } from 'cloudflare:workers';
import { App } from '../components/SiteApp.jsx';
import { publicData } from '../lib/db.mjs';
import copy from '../data/copy.json';
import {structuredData,serializeStructuredData} from '../lib/structured-data.mjs';
import '../styles/site.css';
import headingFont from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import {customerMailConfigured,customerNext} from '../lib/customer-auth.mjs';
import {siteIdentity} from '../lib/site-identity.mjs';
import analytics from '../data/analytics.json';
import {indexablePage} from '../lib/search-indexing.mjs';
import {externalAnalyticsEnabled} from '../lib/external-analytics.mjs';
import {basePath,routeLocale,localePath,htmlLanguage,localeCodes} from '../lib/locale.mjs';
import {localeMetadata,localizedItem} from '../lib/locale-content.mjs';
const localizedPath=Astro.url.pathname==='/'?'/':Astro.url.pathname.replace(/\/?$/,'/');
const locale=routeLocale(localizedPath),path=basePath(localizedPath);
if(path==='/legal-notice/')return Astro.redirect(localePath('/contact/#company-information',locale),301);
const site=await publicData(env);
const {customer,canManage}=await siteIdentity(Astro.request,env);
if(['/get-a-quote/','/account/'].includes(path)&&!customer)return Astro.redirect(localePath('/sign-in/',locale)+'?'+new URLSearchParams({next:customerNext(localizedPath+Astro.url.search,locale)}),303);
if(path==='/sign-in/'&&customer)return Astro.redirect(customerNext(Astro.url.searchParams.get('next'),locale),303);
const customerSite={...site,canManage,customer:customer?(['/get-a-quote/','/account/'].includes(path)?{id:customer.id,email:customer.email}:{signedIn:true}):null,settings:{...site.settings,customerGoogleEnabled:!!(env.GOOGLE_CLIENT_ID&&env.GOOGLE_CLIENT_SECRET),customerEmailEnabled:customerMailConfigured(env)}};
const item=site.products.find((p:{slug:string;seoTitle?:string;seoDescription?:string;title:string;intro:string;indexable?:boolean})=>path===`/products/${p.slug}/`)||site.works.find((p:{slug:string;seoTitle?:string;seoDescription?:string;title:string;intro:string;indexable?:boolean})=>path===`/projects/${p.slug}/`)||site.pages.find((p:{slug:string;seoTitle?:string;seoDescription?:string;title:string;intro:string;indexable?:boolean})=>path===`/${p.slug}/`)||site.landings.find((p:{slug:string;seoTitle?:string;seoDescription?:string;title:string;intro:string;indexable?:boolean})=>path===`/landing/${p.slug}/`);
const policy=copy.policies.find(p=>p.route===path);
const fixed:Record<string,[string,string]>={
 '/':['Custom Signs, Made for Your Business','Custom business signs, illuminated lettering and dimensional signage. Explore styles and discuss your custom project.'],
 '/products/':['Custom Sign Styles','Compare illuminated, metal, acrylic and specialty custom sign styles for your commercial space.'],
 '/projects/':['Commercial Sign Design Library','Explore storefront, office and hospitality sign concepts, with materials, lighting, mounting and fabrication details for your own project.'],
 '/contact/':['Contact Us','Contact Custom Sign Forge by project form, email or WhatsApp to discuss your custom business sign.'],
 '/get-a-quote/':['Get a Custom Sign Quote','Share a few project details to discuss your custom sign requirements and quote.'],
 '/sign-in/':['Customer Sign In','Sign in with Google or verify your email to request a custom sign quote.'],
 '/account/':['Your Sign Enquiries','Review the custom sign enquiries saved to your customer account.']
};
const designOnly=['/design-kit/','/review/products/','/review/work/','/review/custom/'];
const found=!!item||!!policy||!!fixed[path]||(env.APP_ENV!=='production'&&designOnly.includes(path));
if(!found)Astro.response.status=404;
const reviewTitle=env.APP_ENV!=='production'&&designOnly.includes(path)?'Homepage Design Review':null;
const translated=localeMetadata(path,item,policy,locale);
const title=(translated?.title||item?.seoTitle||item?.title||policy?.title||fixed[path]?.[0]||reviewTitle||'Page Not Found')+' | Custom Sign Forge';
const description=translated?.description||item?.seoDescription||item?.intro||fixed[path]?.[1]||'Custom Sign Forge business signage information.';
const base=String(env.SITE_URL||'https://customsignforge.com').replace(/\/$/,'');
const canonical=base+localizedPath;
const indexable=indexablePage(env,{path:localizedPath,found,policy:!!policy,item});
const analyticsEnabled=externalAnalyticsEnabled({environment:env.APP_ENV,path:localizedPath,found,policy:!!policy,canManage});
Astro.response.headers.set('Cache-Control','no-store');
const schema=structuredData({base,path:localizedPath,title,description,settings:site.settings,item:localizedItem(item,locale),found,locale});
---
<!doctype html><html lang={htmlLanguage(locale)}><head>
 <meta charset="UTF-8"/><link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{title}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow':'noindex,follow'}/>
 <link rel="canonical" href={canonical}/>{indexable&&<>{localeCodes.map(code=><link rel="alternate" hreflang={htmlLanguage(code)} href={base+localePath(path,code)}/>)}<link rel="alternate" hreflang="x-default" href={base+localePath(path,'en')}/></>}<link rel="icon" type="image/svg+xml" href="/brand/icon.svg"/><link rel="icon" href="/brand/favicon.ico"/><link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/><link rel="manifest" href="/brand/site.webmanifest"/>
 <meta name="theme-color" content="#20272d"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={base+'/brand/og-image.png'}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json" set:html={schema?serializeStructuredData(schema):'null'}></script>
<script id="csf-analytics-config" type="application/json" set:html={JSON.stringify({...analytics,language:htmlLanguage(locale),enabled:analyticsEnabled})}></script>
</head><body><noscript><style>.quote-layout form,.customer-login-card form{display:none}</style><p style="padding:20px;text-align:center">{locale==='pt-br'?'Ative o JavaScript para entrar na sua conta e enviar uma solicitação de orçamento, ou use os contatos abaixo.':locale==='ko'?'로그인과 견적 문의를 제출하려면 JavaScript를 켜 주세요. 아래 연락처로도 문의하실 수 있습니다.':locale==='fr'?'Activez JavaScript pour vous connecter et envoyer votre demande, ou utilisez les coordonnées ci-dessous.':locale==='de'?'Aktivieren Sie JavaScript, um sich anzumelden und eine Anfrage zu senden, oder nutzen Sie die Kontaktdaten unten.':locale==='th'?'โปรดเปิดใช้ JavaScript เพื่อเข้าสู่ระบบและส่งคำขอเสนอราคา หรือใช้ข้อมูลติดต่อด้านล่าง':locale==='ms'?'Aktifkan JavaScript untuk log masuk dan menghantar pertanyaan, atau gunakan maklumat hubungan di bawah.':locale==='zh'?'请启用 JavaScript 以登录和提交询价，或使用下方的商务联系方式。':'Enable JavaScript to sign in and submit your enquiry, or use the business contact details below.'}</p></noscript><App site={customerSite} path={found?localizedPath:localePath('/not-found/',locale)} query={Astro.url.search} client:load/>
<script>
 import {startMeasurement} from '../lib/browser-measurement.mjs';
 import {startExternalAnalytics} from '../lib/external-analytics.mjs';
 startMeasurement();
 const analyticsConfig=document.getElementById('csf-analytics-config');
 if(analyticsConfig)startExternalAnalytics(JSON.parse(analyticsConfig.textContent||'{}'));
</script></body></html>
